@misc{tanDroughtSetUnderstandingDrought2024,
  title = {{{DroughtSet}}: {{Understanding Drought Through Spatial-Temporal Learning}}},
  shorttitle = {{{DroughtSet}}},
  author = {Tan, Xuwei and Zhao, Qian and Liu, Yanlan and Zhang, Xueru},
  year = 2024,
